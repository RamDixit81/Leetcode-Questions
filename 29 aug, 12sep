class Solution {
public:
    int minBishopMoves(vector<int>& source, vector<int>& target) {
        int sr = source[0];
        int sc = source[1];

        int tr = target[0];
        int tc = target[1];

        if(sr == tr && sc == tc)
            return 0;
        if((sr + sc) % 2 != (tr + tc) % 2)
            return -1;
        if(abs(sr - tr) == abs(sc - tc))
            return 1;
        
return 2;
        
    }
};
#count value with equal spaced 
class Solution {
public:
    int countSpecialIntegers(vector<int>& nums) {
        map<int, vector<int>> m1;
        for(int i =0; i<nums.size(); i++){
            m1[nums[i]].push_back(i);
            
        }
        int ans = 0;
        for(auto &p : m1) {
            vector<int>& v = p.second;

            if(v.size() == 3 && v[1] - v[0] == v[2] - v[1]){
                ans++;
                
            }
        }
        return ans;
    }
};
