class Solution {
public:
    vector<vector<int>> fun(int i, int j, vector<vector<int>>& matrix,
                            vector<vector<int>>& ans) {
        if(i == matrix.size())
            return ans;

        ans[j][i] = matrix[i][j];

        if(j == matrix[0].size() - 1)
            return fun(i + 1, 0, matrix, ans);

        return fun(i, j + 1, matrix, ans);
    }

    vector<vector<int>> transpose(vector<vector<int>>& matrix) {
        vector<vector<int>> ans(matrix[0].size(),
                                vector<int>(matrix.size()));

        return fun(0, 0, matrix, ans);
    }
};
