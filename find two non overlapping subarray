class Solution {
public:
    int minSumOfLengths(vector<int>& arr, int target) {

        int n = arr.size();
        int INF = 1000000;

        vector<int> dp(n, INF);

        unordered_map<int, int> mp;
        
        mp[0] = -1;

        int sum = 0;
        int ans = INF;

        for (int i = 0; i < n; i++) {

            sum += arr[i];

            if (i > 0) {
                dp[i] = dp[i - 1];
            }

            if (mp.find(sum - target) != mp.end()) {

                int j = mp[sum - target];
                int len = i - j;

                if (j >= 0 && dp[j] != INF) {
                    ans = min(ans, len + dp[j]);
                }
                dp[i] = min(dp[i], len);
            }

            mp[sum] = i;
        }

        if (ans == INF) {
            return -1;
        }

        return ans;
    }
};
